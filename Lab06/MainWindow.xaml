<Window x:Class="Lab06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Lab06.Converters"
        Title="Лабораторная работа №6 — Привязка данных и конвертеры"
        Width="780"
        Height="470"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <conv:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <conv:AgeToBrushConverter x:Key="AgeToBrushConverter"/>
    </Window.Resources>

    <Grid x:Name="mainGrid" Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: список объектов в ListBox -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <DockPanel>
                <TextBlock x:Name="txtListHeader"
                           DockPanel.Dock="Top"
                           Text="Список пользователей"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="lstPeople"
                         ItemsSource="{Binding People}"
                         SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                         BorderBrush="#E2E8F0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,5">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Age, StringFormat=Возраст: {0} лет}"
                                               Foreground="{Binding Age, Converter={StaticResource AgeToBrushConverter}}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                               Foreground="#475569"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Правая часть: двусторонняя привязка и предпросмотр -->
        <Border Grid.Column="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <StackPanel x:Name="editorPanel" DataContext="{Binding SelectedPerson}">
                <TextBlock x:Name="txtEditorHeader"
                           Text="Редактирование выбранной модели"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,14"/>

                <TextBlock Text="Имя:" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="txtName"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Padding="6,4"
                         FontSize="14"
                         Margin="0,4,0,12"/>

                <TextBlock Text="Возраст (ползунок и поле):" FontWeight="SemiBold" Foreground="#334155"/>
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="sldAge"
                            Grid.Column="0"
                            Minimum="5"
                            Maximum="100"
                            Value="{Binding Age, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <TextBox x:Name="txtAge"
                             Grid.Column="1"
                             Text="{Binding Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="6,3"
                             FontSize="14"
                             TextAlignment="Center"/>
                </Grid>

                <CheckBox x:Name="chkIsActive"
                          Content="Активный пользователь"
                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                          FontSize="14"
                          Margin="0,0,0,18"/>

                <Border Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Предпросмотр привязки и конвертеров:"
                                   FontWeight="Bold"
                                   Foreground="#1E3A8A"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="txtPreviewName"
                                   Text="{Binding Name, StringFormat=Имя: {0}}"
                                   FontSize="14"
                                   Margin="0,2"/>

                        <TextBlock x:Name="txtPreviewAge"
                                   Text="{Binding Age, StringFormat=Возраст: {0} лет}"
                                   Foreground="{Binding Age, Converter={StaticResource AgeToBrushConverter}}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,4"/>

                        <TextBlock x:Name="txtPreviewStatus"
                                   Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}, StringFormat=Статус: {0}}"
                                   FontSize="14"
                                   Margin="0,2"/>

                        <TextBlock Text="Цвет возраста: &lt;18 — красный, 18–60 — чёрный, &gt;60 — синий"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
