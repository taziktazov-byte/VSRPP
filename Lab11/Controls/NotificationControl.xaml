<UserControl x:Class="Lab11.Controls.NotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucRoot">
    <Border Background="#DBEAFE"
            BorderBrush="#3B82F6"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtNotification"
                       Grid.Column="0"
                       Text="{Binding MessageText, ElementName=ucRoot}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="#1E3A8A"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Button x:Name="btnCloseNotification"
                    Grid.Column="1"
                    Content="Закрыть"
                    Padding="10,4"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Click="BtnCloseNotification_Click"/>
        </Grid>
    </Border>
</UserControl>
