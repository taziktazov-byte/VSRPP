<Window x:Class="Lab11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lab11.Controls"
        Title="Лабораторная работа №11 — Кастомные элементы и шаблоны"
        Width="580"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Переопределённый шаблон Button с градиентом и VisualStateManager -->
        <Style x:Key="GradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="GradStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#3B82F6" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="GradStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1D4ED8" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="GradStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#60A5FA" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="GradStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#2563EB" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="GradStop1"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1E40AF" Duration="0:0:0.1"/>
                                            <ColorAnimation Storyboard.TargetName="GradStop2"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1E3A8A" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Rectangle RadiusX="10" RadiusY="10">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="GradStop1" Color="#3B82F6" Offset="0"/>
                                        <GradientStop x:Name="GradStop2" Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вариант 2: ToggleButton с шаблоном и анимацией фона -->
        <Style x:Key="AnimatedToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="ToggleRoot" Width="168" Height="42">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#94A3B8" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#10B981" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="38" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="SwitchTrack"
                                    CornerRadius="21"
                                    Padding="4">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#94A3B8"/>
                                </Border.Background>
                                <Grid>
                                    <Ellipse Width="32" Height="32"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="2,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <ContentPresenter HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0"
                                                      TextElement.Foreground="White"
                                                      TextElement.FontWeight="Bold"
                                                      TextElement.FontSize="13"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Круглая форма окна -->
    <Grid x:Name="outerGrid">
        <Ellipse Width="556" Height="556"
                 Fill="#F8FAFC"
                 Stroke="#2563EB"
                 StrokeThickness="4"/>

        <Grid Width="556" Height="556">
            <Grid.Clip>
                <EllipseGeometry Center="278,278" RadiusX="276" RadiusY="276"/>
            </Grid.Clip>

            <StackPanel x:Name="contentStack"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="400">

                <TextBlock x:Name="txtWindowTitle"
                           Text="Круглое окно WPF"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Перетаскивайте мышью в любой точке"
                           FontSize="11.5"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,14"/>

                <!-- Пользовательский UserControl «Уведомление» -->
                <controls:NotificationControl x:Name="notificationControl"
                                              MessageText="{Binding NotificationText}"
                                              CloseCommand="{Binding CloseNotificationCommand}"
                                              Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}"
                                              Margin="0,0,0,14"/>

                <!-- Вариант 2: ToggleButton с анимацией фона -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                    <ToggleButton x:Name="tglSwitch"
                                  Style="{StaticResource AnimatedToggleStyle}"
                                  IsChecked="{Binding IsToggleChecked, Mode=TwoWay}"
                                  Content="Режим"/>
                    <TextBlock x:Name="txtToggleStatus"
                               Text="{Binding ToggleStatusText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Кнопки с переопределённым ControlTemplate и VisualStateManager -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button x:Name="btnShowNotification"
                            Content="Показать уведомление"
                            Style="{StaticResource GradientButtonStyle}"
                            Command="{Binding ShowNotificationCommand}"
                            Margin="0,0,10,0"/>

                    <Button x:Name="btnAnalyzeTree"
                            Content="Анализ дерева"
                            Style="{StaticResource GradientButtonStyle}"
                            Command="{Binding AnalyzeTreesCommand}"/>
                </StackPanel>

                <Border Background="#EEF2FF"
                        BorderBrush="#C7D2FE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,14">
                    <TextBlock x:Name="txtTreeStats"
                               Text="{Binding TreeSummary}"
                               FontSize="11.5"
                               Foreground="#312E81"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>

                <Button x:Name="btnCloseWindow"
                        Content="Закрыть окно"
                        Width="140"
                        Style="{StaticResource GradientButtonStyle}"
                        Command="{Binding CloseAppCommand}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
