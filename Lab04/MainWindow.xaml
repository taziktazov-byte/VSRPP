<Window x:Class="Lab04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №4 — Справочник разработчика"
        Width="960"
        Height="620"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхний заголовок (DockPanel + TextBlock) -->
        <DockPanel x:Name="headerDockPanel"
                   Grid.Row="0"
                   Background="#1E3A8A"
                   LastChildFill="False"
                   Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Left" Margin="18,12">
                <TextBlock x:Name="txtHeaderTitle"
                           Text="Многооконный справочник технологий"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="txtHeaderSubtitle"
                           Text="Панели компоновки WPF: Grid, DockPanel, StackPanel, WrapPanel, Canvas + TreeView"
                           FontSize="12.5"
                           Foreground="#BFDBFE"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#2563EB"
                    CornerRadius="6"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0">
                <TextBlock x:Name="txtCurrentBranch"
                           Text="Выбрано: Обзор"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="12.5"/>
            </Border>
        </DockPanel>

        <!-- Основная рабочая область -->
        <Grid x:Name="workspaceGrid" Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="210"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель навигации: StackPanel + TreeView (Вариант 2) -->
            <Border x:Name="leftNavBorder"
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <DockPanel x:Name="leftNavPanel">
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock x:Name="txtNavTitle"
                                   Text="Навигация (TreeView)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>
                        <TextBlock Text="Раскройте ветку для просмотра разделов"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TreeView x:Name="tvCategories"
                              BorderThickness="0"
                              FontSize="13.5"
                              SelectedItemChanged="TvCategories_SelectedItemChanged">
                        <TreeViewItem x:Name="tviLanguages" Header="Языки программирования" Tag="lang_root" IsExpanded="True">
                            <TreeViewItem x:Name="tviCSharp" Header="C# (.NET 8)" Tag="csharp"/>
                            <TreeViewItem x:Name="tviPython" Header="Python" Tag="python"/>
                            <TreeViewItem x:Name="tviTypeScript" Header="TypeScript" Tag="ts"/>
                        </TreeViewItem>
                        <TreeViewItem x:Name="tviFrameworks" Header="Платформы UI" Tag="ui_root" IsExpanded="True">
                            <TreeViewItem x:Name="tviWpf" Header="WPF (XAML)" Tag="wpf"/>
                            <TreeViewItem x:Name="tviWinForms" Header="Windows Forms" Tag="winforms"/>
                            <TreeViewItem x:Name="tviMaui" Header=".NET MAUI" Tag="maui"/>
                        </TreeViewItem>
                        <TreeViewItem x:Name="tviDatabases" Header="Системы хранения" Tag="db_root">
                            <TreeViewItem x:Name="tviPostgres" Header="PostgreSQL" Tag="postgres"/>
                            <TreeViewItem x:Name="tviSqlite" Header="SQLite" Tag="sqlite"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Правая панель подробной информации -->
            <Border x:Name="rightContentBorder"
                    Grid.Column="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid x:Name="rightContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="detailsHeaderPanel" Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock x:Name="txtCategoryTitle"
                                   Text="Выберите категорию слева"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="txtCategoryDescription"
                                   Text="В дереве категорий можно раскрывать ветки и переключаться между логическими страницами."
                                   FontSize="13"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <TabControl x:Name="tabPages" Grid.Row="1">
                        <TabItem x:Name="tabCards" Header="Карточки (WrapPanel)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <WrapPanel x:Name="cardsWrapPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="tabCanvas" Header="Схема слоёв (Canvas)">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="diagramCanvas" Width="600" Height="360" Background="#F8FAFC">
                                    <Border Canvas.Left="30" Canvas.Top="24" Width="540" Height="74"
                                            Background="#DBEAFE" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Слой представления (View / XAML)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                            <TextBlock Text="DockPanel, Grid, TreeView, TabControl, WrapPanel" FontSize="12" Foreground="#1E40AF"/>
                                        </StackPanel>
                                    </Border>

                                    <Line X1="300" Y1="98" X2="300" Y2="138" Stroke="#64748B" StrokeThickness="2"/>

                                    <Border Canvas.Left="30" Canvas.Top="138" Width="540" Height="74"
                                            Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1.5" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Слой логики и навигации" FontWeight="Bold" Foreground="#14532D"/>
                                            <TextBlock x:Name="txtCanvasSelectedInfo"
                                                       Text="Активный раздел: Обзор"
                                                       FontSize="12"
                                                       Foreground="#166534"/>
                                        </StackPanel>
                                    </Border>

                                    <Line X1="300" Y1="212" X2="300" Y2="252" Stroke="#64748B" StrokeThickness="2"/>

                                    <Border Canvas.Left="30" Canvas.Top="252" Width="540" Height="74"
                                            Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1.5" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Справочные данные" FontWeight="Bold" Foreground="#78350F"/>
                                            <TextBlock Text="Структурированное описание технологий и их особенностей" FontSize="12" Foreground="#92400E"/>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель управления (DockPanel с кнопками) -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="14,10">
            <DockPanel x:Name="footerDockPanel" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="btnExpandAll"
                            Content="Раскрыть дерево"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Click="BtnExpandAll_Click"/>
                    <Button x:Name="btnCollapseAll"
                            Content="Свернуть дерево"
                            Padding="14,6"
                            Click="BtnCollapseAll_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnSwitchPage"
                            Content="Переключить вкладку"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnSwitchPage_Click"/>
                    <Button x:Name="btnAbout"
                            Content="Справка"
                            Padding="14,6"
                            Click="BtnAbout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
