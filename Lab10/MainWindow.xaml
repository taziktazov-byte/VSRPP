<Window x:Class="Lab10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №10 — Визуальные эффекты и анимации в WPF"
        Width="860"
        Height="580"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <PathGeometry x:Key="MotionPath">
            <PathFigure StartPoint="40,110" IsClosed="True">
                <BezierSegment Point1="140,20" Point2="240,200" Point3="340,110"/>
                <BezierSegment Point1="260,210" Point2="120,20" Point3="40,110"/>
            </PathFigure>
        </PathGeometry>

        <Storyboard x:Key="MainAnimationStoryboard" RepeatBehavior="Forever">
            <!-- 1. Простая анимация размера Rectangle с EasingFunction (BounceEase) -->
            <DoubleAnimation Storyboard.TargetName="animatedRect"
                             Storyboard.TargetProperty="Width"
                             From="90" To="190" Duration="0:0:2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <BounceEase Bounces="3" Bounciness="2" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="animatedRect"
                             Storyboard.TargetProperty="Height"
                             From="60" To="110" Duration="0:0:2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2. Анимация прозрачности (Opacity) для Ellipse -->
            <DoubleAnimation Storyboard.TargetName="animatedEllipse"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.15" Duration="0:0:1.5"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 3. Анимация по ключевым кадрам (KeyFrames) для TextBlock: перемещение, поворот и цвет -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="txtKeyframe"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="130">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="txtKeyframe"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="12"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="txtKeyframe"
                                          Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#1E3A8A"/>
                <LinearColorKeyFrame KeyTime="0:0:1.5" Value="#DC2626"/>
                <LinearColorKeyFrame KeyTime="0:0:3" Value="#0F766E"/>
            </ColorAnimationUsingKeyFrames>

            <!-- 4. Анимация по пути (PathAnimation) -->
            <MatrixAnimationUsingPath Storyboard.TargetName="pathRunner"
                                      Storyboard.TargetProperty="(UIElement.RenderTransform).(MatrixTransform.Matrix)"
                                      PathGeometry="{StaticResource MotionPath}"
                                      Duration="0:0:4"
                                      DoesRotateWithTangent="False"/>

            <!-- 5. Вариант 2: TextBlock всплывает сверху вниз и исчезает с затуханием (Opacity) -->
            <DoubleAnimation Storyboard.TargetName="txtFloatingFade"
                             Storyboard.TargetProperty="(Canvas.Top)"
                             From="24" To="125" Duration="0:0:3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="txtFloatingFade"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:3"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="mainGrid" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtHeader"
                   Grid.Row="0"
                   Text="Анимации WPF: DoubleAnimation, KeyFrames, PathAnimation и Easing"
                   FontSize="19"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Rectangle, Ellipse, KeyFrame TextBlock -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Canvas x:Name="leftCanvas" Background="#F8FAFC" ClipToBounds="True">
                    <TextBlock Canvas.Left="12" Canvas.Top="10"
                               Text="Размер (BounceEase) + Opacity + KeyFrames:"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <Rectangle x:Name="animatedRect"
                               Canvas.Left="24"
                               Canvas.Top="48"
                               Width="90"
                               Height="60"
                               RadiusX="8"
                               RadiusY="8"
                               Fill="#3B82F6"/>

                    <Ellipse x:Name="animatedEllipse"
                             Canvas.Left="250"
                             Canvas.Top="48"
                             Width="95"
                             Height="95"
                             Fill="#F59E0B"/>

                    <TextBlock x:Name="txtKeyframe"
                               Canvas.Left="24"
                               Canvas.Top="210"
                               Text="KeyFrames текст!"
                               FontSize="20"
                               FontWeight="Bold"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#1E3A8A"/>
                        </TextBlock.Foreground>
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform X="0" Y="0"/>
                                <RotateTransform Angle="0"/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Canvas.Left="12" Canvas.Top="285"
                               Text="Внизу — анимация перемещения, поворота и цвета по ключевым кадрам"
                               FontSize="11.5"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Width="350"/>
                </Canvas>
            </Border>

            <!-- Правая панель: PathAnimation и Вариант 2 (сверху вниз с затуханием) -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верх: PathAnimation -->
                    <Canvas x:Name="pathCanvas" Grid.Row="0" Background="#F8FAFC" ClipToBounds="True">
                        <TextBlock Canvas.Left="12" Canvas.Top="8"
                                   Text="Движение по пути (MatrixAnimationUsingPath):"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <Path Data="{StaticResource MotionPath}"
                              Stroke="#94A3B8"
                              StrokeThickness="2"
                              StrokeDashArray="4 2"/>

                        <Ellipse x:Name="pathRunner"
                                 Canvas.Left="-12"
                                 Canvas.Top="-12"
                                 Width="24"
                                 Height="24"
                                 Fill="#10B981"
                                 Stroke="#065F46"
                                 StrokeThickness="2">
                            <Ellipse.RenderTransform>
                                <MatrixTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>

                    <!-- Низ: Вариант 2 — TextBlock сверху вниз с затуханием -->
                    <Canvas x:Name="fadeCanvas" Grid.Row="2" Background="#EEF2FF" ClipToBounds="True">
                        <TextBlock Canvas.Left="12" Canvas.Top="4"
                                   Text="Вариант 2: всплытие сверху вниз + Opacity"
                                   FontSize="11.5"
                                   Foreground="#475569"/>
                        <TextBlock x:Name="txtFloatingFade"
                                   Canvas.Left="55"
                                   Canvas.Top="16"
                                   Text="Плавное появление и затухание"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4338CA"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <!-- Кнопки управления анимацией -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
            <Button x:Name="btnStartAnimation"
                    Content="Запуск анимации"
                    Width="170"
                    Height="38"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,12,0"
                    Click="BtnStartAnimation_Click"/>

            <Button x:Name="btnStopAnimation"
                    Content="Остановить"
                    Width="150"
                    Height="38"
                    FontSize="14"
                    Background="#E2E8F0"
                    Foreground="#0F172A"
                    Click="BtnStopAnimation_Click"/>
        </StackPanel>
    </Grid>
</Window>
