<Window x:Class="Lab08.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №8 — Команды и ICommand в MVVM"
        Width="560"
        Height="500"
        MinWidth="460"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid x:Name="mainGrid" Margin="22">
        <Border Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22">
            <StackPanel>
                <TextBlock x:Name="txtHeader"
                           Text="Команды ICommand и CommandParameter"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Имя пользователя:" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="txtName"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         FontSize="14"
                         Padding="6,4"
                         Margin="0,4,0,10"/>

                <TextBlock Text="Возраст:" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="txtAge"
                         Text="{Binding Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         FontSize="14"
                         Padding="6,4"
                         Margin="0,4,0,10"/>

                <CheckBox x:Name="chkIsStudent"
                          Content="Студент"
                          IsChecked="{Binding IsStudent, Mode=TwoWay}"
                          FontSize="14"
                          Margin="0,4,0,16"/>

                <!-- Основные команды -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnShowInfo"
                            Grid.Column="0"
                            Content="Показать инфо"
                            Height="36"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding ShowInfoCommand}"/>

                    <Button x:Name="btnDeleteUser"
                            Grid.Column="2"
                            Content="Удалить пользователя"
                            Height="36"
                            FontSize="13.5"
                            Command="{Binding DeleteUserCommand}"
                            CommandParameter="{Binding Name}"/>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnOpenFile"
                            Grid.Column="0"
                            Content="Выбрать файл..."
                            Height="36"
                            FontSize="13.5"
                            Command="{Binding ShowDialogCommand}"/>

                    <!-- Вариант 2: команда «Подтвердить» с CommandParameter -->
                    <Button x:Name="btnConfirm"
                            Grid.Column="2"
                            Content="Подтвердить"
                            Height="36"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding ConfirmCommand}"
                            CommandParameter="{Binding Name}"/>
                </Grid>

                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Выбранный файл:" FontWeight="Bold" Foreground="#334155"/>
                        <TextBlock x:Name="txtSelectedFile"
                                   Text="{Binding SelectedFilePath}"
                                   FontSize="12.5"
                                   Foreground="#0F766E"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,8"/>

                        <TextBlock Text="Статус выполнения команд:" FontWeight="Bold" Foreground="#334155"/>
                        <TextBlock x:Name="txtStatus"
                                   Text="{Binding StatusMessage}"
                                   FontSize="12.5"
                                   Foreground="#1E40AF"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
