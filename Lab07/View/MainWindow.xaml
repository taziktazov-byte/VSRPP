<Window x:Class="Lab07.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №7 — Паттерн MVVM"
        Width="520"
        Height="470"
        MinWidth="440"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid x:Name="mainGrid" Margin="22">
        <Border Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22">
            <StackPanel x:Name="rootStack">
                <TextBlock x:Name="txtHeader"
                           Text="Профиль пользователя (MVVM)"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Имя:" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="txtName"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         FontSize="14"
                         Padding="6,4"
                         Margin="0,4,0,12"/>

                <TextBlock Text="Возраст:" FontWeight="SemiBold" Foreground="#334155"/>
                <Slider x:Name="sldAge"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Age, Mode=TwoWay}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0,6,0,12"/>

                <CheckBox x:Name="chkIsStudent"
                          Content="Является студентом"
                          IsChecked="{Binding IsStudent, Mode=TwoWay}"
                          FontSize="14"
                          Margin="0,0,0,16"/>

                <!-- Отображение текущих значений через привязку -->
                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Текущие значения модели:"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtNameDisplay"
                                   Text="{Binding Name, Mode=TwoWay, StringFormat=Имя: {0}}"
                                   FontSize="13.5"
                                   Margin="0,2"/>
                        <TextBlock x:Name="txtAgeDisplay"
                                   Text="{Binding Age, Mode=TwoWay, StringFormat=Возраст: {0} лет}"
                                   FontSize="13.5"
                                   Margin="0,2"/>
                        <TextBlock x:Name="txtStudentStatus"
                                   Text="{Binding StudentStatusText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Кнопки команд -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnSave"
                            Grid.Column="0"
                            Content="Сохранить"
                            Height="36"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding SaveCommand}"/>

                    <Button x:Name="btnClear"
                            Grid.Column="2"
                            Content="Очистить"
                            Height="36"
                            FontSize="14"
                            Command="{Binding ClearCommand}"/>
                </Grid>

                <!-- Вариант 2: новая команда «Сделать совершеннолетним» -->
                <Button x:Name="btnMakeAdult"
                        Content="Сделать совершеннолетним (Age = 18)"
                        Height="36"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Background="#0F766E"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding MakeAdultCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
