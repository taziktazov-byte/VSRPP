<Application x:Class="Lab05.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Глобальный цвет для всех CheckBox -->
            <SolidColorBrush x:Key="GlobalCheckBoxBrush" Color="#0F766E"/>

            <!-- Глобальный стиль для Label -->
            <Style x:Key="GlobalLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Padding" Value="0,4"/>
            </Style>

            <!-- Глобальный стиль для CheckBox -->
            <Style x:Key="GlobalCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Foreground" Value="{StaticResource GlobalCheckBoxBrush}"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
