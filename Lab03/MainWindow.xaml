<Window x:Class="Lab03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №3 — Первое WPF-приложение"
        Width="460"
        Height="340"
        MinWidth="380"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <Grid x:Name="mainGrid" Margin="24">
        <Border Background="White"
                CornerRadius="10"
                Padding="22"
                BorderBrush="#DCE3EE"
                BorderThickness="1">
            <StackPanel x:Name="mainStackPanel" VerticalAlignment="Center">
                <Label x:Name="lblTitle"
                       Content="Добро пожаловать в WPF!"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1E3A5F"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

                <Label x:Name="lblNamePrompt"
                       Content="Введите ваше имя:"
                       FontSize="14"
                       Foreground="#334155"
                       Padding="0,0,0,4"/>

                <TextBox x:Name="txtUserName"
                         Height="34"
                         FontSize="14"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                <CheckBox x:Name="chkShowDate"
                          Content="Показать дату"
                          FontSize="13.5"
                          Foreground="#334155"
                          Margin="0,0,0,14"
                          Checked="ChkShowDate_Changed"
                          Unchecked="ChkShowDate_Changed"/>

                <Button x:Name="btnGreet"
                        Content="Поприветствовать"
                        Height="38"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnGreet_Click"/>

                <TextBlock x:Name="txtDateOutput"
                           FontSize="13"
                           Foreground="#0F766E"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="txtGreeting"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1E40AF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
