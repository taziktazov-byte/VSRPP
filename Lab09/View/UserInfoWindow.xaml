<Window x:Class="Lab09.View.UserInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование профиля"
        Width="400"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Редактирование данных пользователя"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1E3A8A"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Имя:" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="txtEditName"
                     Text="{Binding EditableUser.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="32"
                     FontSize="14"
                     Padding="6,4"
                     Margin="0,4,0,12"/>

            <TextBlock Text="Возраст:" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="txtEditAge"
                     Text="{Binding EditableUser.Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="32"
                     FontSize="14"
                     Padding="6,4"
                     Margin="0,4,0,12"/>

            <CheckBox x:Name="chkEditStudent"
                      Content="Студент"
                      IsChecked="{Binding EditableUser.IsStudent, Mode=TwoWay}"
                      FontSize="14"
                      Margin="0,4,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSave"
                        Grid.Column="0"
                        Content="Сохранить"
                        Height="36"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>

                <Button x:Name="btnCancel"
                        Grid.Column="2"
                        Content="Отмена"
                        Height="36"
                        FontSize="14"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
